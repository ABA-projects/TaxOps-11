# TaxOps API — Dockerfile para AWS Lambda (container image)
# Contexto de build: raíz de proyecto-facturas/ (no api/)
# docker build -f api/Dockerfile-lambda -t taxops-api-lambda .
#
# Imagen separada de api/Dockerfile-api (Cloud Run) — no lo reemplaza.
# Esta MISMA imagen la usan dos funciones Lambda (API y worker); el worker
# sobreescribe el CMD por defecto vía image_config.command = ["worker_handler.handler"]
# (ver infra/modules/lambda-api/worker.tf).
#
# NOTA — Tesseract OCR (tesseract-ocr + tesseract-ocr-spa en el Dockerfile-api de
# Debian) NO se instala aquí: Amazon Linux 2023 no lo trae en su repo base, y EPEL 9
# (habilitado y verificado contra el metadata real del repo, para x86_64 y aarch64)
# tampoco publica un paquete `tesseract` — fue retirado de EPEL9. Compilarlo desde
# fuente (leptonica + tesseract) es viable pero cuesta ~10-15 min de build y una
# cadena de toolchain grande, así que se deja fuera de la imagen. Debe adjuntarse
# como Lambda Layer prebuilt (patrón estándar de la comunidad, ej.
# keithrozario/lambda-tesseract-layer) vía `layers = [...]` en el recurso
# aws_lambda_function — cambio de Terraform, fuera de alcance de este Dockerfile.

FROM public.ecr.aws/lambda/python:3.12

# Dependencias del sistema: psycopg2 + libs de Cairo/Pango/GDK-Pixbuf (WeasyPrint) +
# libGL/glib (Pillow/pdfplumber) + fuentes. Nombres de paquete Amazon Linux 2023
# (dnf), distintos a Debian/apt-get:
#   libpq-dev             -> postgresql-devel
#   gcc                    -> gcc
#   libgl1                 -> mesa-libGL
#   libglib2.0-0            -> glib2
#   libcairo2                -> cairo
#   libpango-1.0-0 /
#   libpangoft2-1.0-0         -> pango (incluye pangoft2 en AL2023, no hay subpaquete separado)
#   libgdk-pixbuf-xlib...      -> gdk-pixbuf2
#   libffi-dev                  -> libffi-devel
#   shared-mime-info              -> shared-mime-info (mismo nombre)
#   fonts-liberation                -> liberation-fonts
RUN dnf install -y \
    postgresql-devel gcc \
    mesa-libGL glib2 \
    cairo pango \
    gdk-pixbuf2 libffi-devel shared-mime-info \
    liberation-fonts \
    && dnf clean all

# El WORKDIR base de la imagen Lambda es /var/task (LAMBDA_TASK_ROOT); lo
# cambiamos a /app para que el COPY de abajo reproduzca la misma estructura de
# rutas que api/Dockerfile-api (pipeline/, services/, db/, exogenas/, api/ como
# hermanos bajo /app), y así los imports (`from services...`, `from api.core...`)
# sigan funcionando igual.
WORKDIR /app

# Instalar dependencias Python
COPY api/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copiar código fuente (pipeline compartido + api)
COPY pipeline/ ./pipeline/
COPY services/ ./services/
COPY db/ ./db/
COPY exogenas/ ./exogenas/
COPY api/ ./api/

WORKDIR /app/api

CMD ["main.handler"]
