# TaxOps API — Dockerfile
# Contexto de build: raíz de proyecto-facturas/ (no api/)
# docker build -f api/Dockerfile-api -t taxops-api .

FROM python:3.12-slim

WORKDIR /app

# Dependencias del sistema: pdfplumber + psycopg2 + Tesseract OCR (imágenes)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    tesseract-ocr tesseract-ocr-spa \
    libgl1 libglib2.0-0 \
    libcairo2 libpango-1.0-0 libpangoft2-1.0-0 \
    libgdk-pixbuf2.0-0 libffi-dev shared-mime-info \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Instalar dependencias Python
COPY api/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copiar código fuente (pipeline compartido + api)
COPY pipeline/ ./pipeline/
COPY services/ ./services/
COPY db/ ./db/
COPY exogenas/ ./exogenas/
COPY api/ ./api/

WORKDIR /app/api

EXPOSE 8000
# Railway inyecta PORT dinámicamente; usamos shell form para soportar ${PORT:-8000}
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}
